{
  "name": "zipit-monorepo",
  "version": "2.0.2",
  "private": true,
  "description": "ZipIt — Client-side ZIP streaming & batch download library",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn --cwd apps/web run dev",
    "dev:docs": "npm run dev --workspace @blueneon/zipit-docs",
    "build": "npm run build --workspace @blueneon/zip-it && npm run build --workspace @blueneon/zipit-react",
    "build:all": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release": "node ./scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "prettier": "^3.2.5",
    "@changesets/cli": "^2.27.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
